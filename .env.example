# Copy to .env and enter secrets locally. Never commit .env.
VOC_RESEARCH_BACKEND=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro

# A trusted comment collection service. See docs/deepseek.md for its contract.
# DeepSeek analyzes collected text; its chat endpoint does not collect comments.
VOC_COLLECTOR_URL=
VOC_COLLECTOR_TOKEN=

# Optional V2EX connector. An external collector URL takes precedence.
VOC_COLLECTOR=

# Cloud mode only; set these privately in the hosting dashboard.
# VOC_APP_MODE=cloud
# VOC_PUBLIC_ORIGIN=https://your-service.example.com
# VOC_SESSION_SECRET=generate-at-least-32-random-characters
# VOC_ACCESS_CODES=generate-at-least-16-random-characters-per-code
# VOC_USER_DAILY_LIMIT=3
# VOC_GLOBAL_DAILY_LIMIT=10
