# Copy to .env and enter secrets locally. Never commit .env.
VOC_RESEARCH_BACKEND=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro

# A trusted comment collection service. See docs/deepseek.md for its contract.
# DeepSeek analyzes collected text; its chat endpoint does not collect comments.
VOC_COLLECTOR_URL=
VOC_COLLECTOR_TOKEN=
